{
  "name": "farmed-promo",
  "version": "1.0.0",
  "description": "FARMED 26s promo video (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "assets": "node scripts/prepare-assets.mjs",
    "render:wide": "remotion render Promo-16x9 out/farmed-16x9.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render Promo-9x16 out/farmed-9x16.mp4 --codec=h264 --crf=18",
    "render": "npm run render:wide && npm run render:vertical",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
